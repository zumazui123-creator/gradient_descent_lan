[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/scenes/HelpDialog.gd" id="1_help"]

[sub_resource type="StyleBoxFlat" id="StyleBox_panel"]
bg_color = Color(0.0588235, 0.109804, 0.211765, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.172549, 0.298039, 0.443137, 1)
corner_radius_top_left = 16
corner_radius_top_right = 16
corner_radius_bottom_right = 16
corner_radius_bottom_left = 16

[node name="HelpDialog" type="Control"]
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 0
script = ExtResource("1_help")

[node name="Shade" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 0
color = Color(0.0117647, 0.0352941, 0.0862745, 0.86)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(860, 560)
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBox_panel")

[node name="Margin" type="MarginContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/margin_left = 42
theme_override_constants/margin_top = 32
theme_override_constants/margin_right = 42
theme_override_constants/margin_bottom = 28

[node name="Content" type="VBoxContainer" parent="Center/Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Center/Panel/Margin/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.25098, 0.901961, 1, 1)
theme_override_font_sizes/font_size = 25
text = "So lernt eine KI – vereinfacht"
horizontal_alignment = 1

[node name="Rules" type="Label" parent="Center/Panel/Margin/Content"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/line_spacing = 7
theme_override_font_sizes/font_size = 16
text = "Du spielst die KI; das Schiff ist ihre aktuelle Vermutung.\nDer Schatz steht für die beste Lösung.\nEine Sonde ist ein Lernschritt: ausprobieren und Rückmeldung erhalten.\nDas Gefälle zeigt, in welcher Richtung es tiefer und damit besser wird.\nBewege deine Vermutung in diese Richtung und miss erneut.\nWie weit du fährst, ähnelt der Lernrate: Große Schritte können das Ziel verpassen.\nSo entsteht die Schleife: vermuten → messen → verbessern.\nAber Vorsicht: Ein flaches lokales Tal kann die KI täuschen!\nEchte KI verändert Zahlen, um ihren Fehler schrittweise zu verkleinern.\n\nSteuerung: ← / → oder A / D bewegt das Schiff.\nLeertaste, ↓ oder S startet eine Messung mit 3 Sekunden Ankerzeit.\n40 Sonden pro Spieler; im Team gewinnt das Team des Finders."
horizontal_alignment = 0
vertical_alignment = 1

[node name="CloseButton" type="Button" parent="Center/Panel/Margin/Content"]
custom_minimum_size = Vector2(0, 44)
layout_mode = 2
text = "Schließen  H / Esc"

[connection signal="pressed" from="Center/Panel/Margin/Content/CloseButton" to="." method="_on_close_button_pressed"]
